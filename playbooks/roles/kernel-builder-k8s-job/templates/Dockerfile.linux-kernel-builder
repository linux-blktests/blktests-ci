FROM fedora:41

ARG EXTRA_CA_CERT

RUN if [ -n "${EXTRA_CA_CERT:-}" ]; then \
      printf '%s\n' "$EXTRA_CA_CERT" > /etc/pki/ca-trust/source/anchors/extra-ca-cert.pem && \
      update-ca-trust; \
    fi

RUN dnf ${http_proxy:+--setopt=proxy=$http_proxy} update -y && \
    dnf ${http_proxy:+--setopt=proxy=$http_proxy} install -y \
      git gcc make bc bison flex elfutils-libelf-devel openssl-devel openssl \
      grub2 dracut vim uuid mkisofs libguestfs-tools wget fakeroot cpio jq && \
    dnf clean all && \
    rm -rf /var/cache/dnf

RUN groupadd --gid 1000 builder && \
    useradd --uid 1000 --gid 1000 --create-home --home-dir /home/builder builder && \
    mkdir -p /work && \
    chown 1000:1000 /work

USER 1000:1000
WORKDIR /work
